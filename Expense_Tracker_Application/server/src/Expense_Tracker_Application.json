{
  "openapi": "3.0.0",
  "info": {
    "title": "Expense Tracker API",
    "version": "1.0.0",
    "description": "API documentation for Expense Tracker project"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1"
    }
  ],
  "tags": [
    {
      "name": "Expenses",
      "description": "Các API quản lý khoản chi tiêu"
    },
    {
      "name": "Users",
      "description": "Các API quản lý người d"
    }
  ],

  "paths": {
    "/users": {
      "get": {
        "tags": ["Users"],
        "summary": "Lấy danh sách tất cả người dùng",
        "operationId": "getUsers",
        "responses": {
          "200": {
            "description": "Danh sách người dùng trả về thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/User" }
                }
              }
            }
          },
          "500": {
            "description": "Lỗi server"
          }
        }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Tạo mới một người dùng",
        "operationId": "createUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserInput" },
              "example": {
                "userName": "johndoe",
                "email": "john@example.com",
                "password": "strongPassword123"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tạo người dùng thành công",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "500": {
            "description": "Lỗi server"
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": ["Users"],
        "summary": "Lấy người dùng theo ID",
        "operationId": "getUserById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID của người dùng",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Người dùng tìm thấy",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy người dùng"
          },
          "500": {
            "description": "Lỗi server"
          }
        }
      },
      "put": {
        "tags": ["Users"],
        "summary": "Cập nhật người dùng",
        "operationId": "updateUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID của người dùng",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cập nhật người dùng thành công",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy người dùng"
          },
          "500": {
            "description": "Lỗi server"
          }
        }
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Xóa người dùng",
        "operationId": "deleteUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID của người dùng",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Xóa người dùng thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy người dùng"
          },
          "500": {
            "description": "Lỗi server"
          }
        }
      }
    },
    "/expenses": {
      "get": {
        "tags": ["Expenses"],
        "summary": "Lấy danh sách tất cả chi tiêu",
        "operationId": "getExpenses",
        "responses": {
          "200": {
            "description": "Danh sách chi tiêu trả về thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Expense" }
                }
              }
            }
          },
          "500": {
            "description": "Lỗi server"
          }
        }
      },
      "post": {
        "tags": ["Expenses"],
        "summary": "Tạo mới một khoản chi tiêu",
        "operationId": "createExpense",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ExpenseInput" },
              "example": {
                "title": "Ăn trưa",
                "amount": 50000,
                "type": "expense",
                "category": "Food",
                "date": "2026-03-12",
                "note": "Phở bò ngon"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tạo chi tiêu thành công",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Expense" }
              }
            }
          },
          "400": {
            "description": "Thiếu trường bắt buộc"
          },
          "500": {
            "description": "Lỗi server"
          }
        }
      }
    },
    "/expenses/{id}": {
      "get": {
        "tags": ["Expenses"],
        "summary": "Lấy chi tiết một khoản chi tiêu",
        "operationId": "getExpenseById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID của khoản chi tiêu",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Chi tiết chi tiêu",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Expense" }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy khoản chi tiêu"
          },
          "500": {
            "description": "Lỗi server"
          }
        }
      },
      "put": {
        "tags": ["Expenses"],
        "summary": "Cập nhật khoản chi tiêu",
        "operationId": "updateExpense",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID của khoản chi tiêu",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ExpenseInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cập nhật thành công",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Expense" }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy khoản chi tiêu"
          },
          "500": {
            "description": "Lỗi server"
          }
        }
      },
      "delete": {
        "tags": ["Expenses"],
        "summary": "Xóa một khoản chi tiêu",
        "operationId": "deleteExpense",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID của khoản chi tiêu",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Xóa thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Expense" }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy khoản chi tiêu"
          },
          "500": {
            "description": "Lỗi server"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "required": ["id", "userName", "email", "password"],
        "properties": {
          "id": {
            "type": "string",
            "description": "ID duy nhất của người dùng",
            "example": "1ds41"
          },
          "userName": {
            "type": "string",
            "description": "Tên người dùng",
            "example": "johndoe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email của người dùng",
            "example": "john@example.com"
          },
          "password": {
            "type": "string",
            "description": "Mật khẩu người dùng",
            "example": "strongPassword123"
          }
        }
      },
      "UserInput": {
        "type": "object",
        "required": ["userName", "email", "password"],
        "properties": {
          "userName": {
            "type": "string",
            "description": "Tên người dùng",
            "example": "johndoe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email của người dùng",
            "example": "john@example.com"
          },
          "password": {
            "type": "string",
            "description": "Mật khẩu người dùng",
            "example": "strongPassword123"
          }
        }
      },
      "Expense": {
        "type": "object",
        "required": ["id", "title", "amount", "type", "category", "date"],
        "properties": {
          "id": {
            "type": "string",
            "description": "ID duy nhất của chi tiêu",
            "example": "12sac"
          },
          "title": {
            "type": "string",
            "description": "Tiêu đề chi tiêu",
            "example": "Ăn trưa"
          },
          "amount": {
            "type": "number",
            "description": "Số tiền (VND)",
            "example": 50000
          },
          "type": {
            "type": "string",
            "enum": ["expense", "income"],
            "description": "Loại giao dịch",
            "example": "expense"
          },
          "category": {
            "type": "string",
            "description": "Hạng mục chi tiêu",
            "example": "Food"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Ngày ghi chi tiêu (YYYY-MM-DD)",
            "example": "2026-03-12"
          },
          "note": {
            "type": "string",
            "description": "Ghi chú thêm",
            "example": "Phở bò"
          }
        }
      },
      "ExpenseInput": {
        "type": "object",
        "required": ["title", "amount", "type", "category", "date"],
        "properties": {
          "title": {
            "type": "string",
            "description": "Tiêu đề chi tiêu",
            "example": "Ăn trưa"
          },
          "amount": {
            "type": "number",
            "description": "Số tiền (VND)",
            "example": 50000
          },
          "type": {
            "type": "string",
            "enum": ["expense", "income"],
            "description": "Loại giao dịch",
            "example": "expense"
          },
          "category": {
            "type": "string",
            "description": "Hạng mục chi tiêu",
            "example": "Food"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Ngày ghi chi tiêu (YYYY-MM-DD)",
            "example": "2026-03-12"
          },
          "note": {
            "type": "string",
            "description": "Ghi chú thêm (tùy chọn)",
            "example": "Phở bò ngon"
          }
        }
      }
    }
  }
}
