{
  "openapi": "3.0.0",
  "info": {
    "title": "Expense Tracker API",
    "version": "1.0.0",
    "contact": {
      "name": "Hoàng Lanh",
      "email": "lanh.le.2005.it@gmail.com"
    },
    "description": "Hệ thống quản lý chi tiêu cá nhân sử dụng Node.js & JSON File Storage."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development server"
    }
  ],
  "tags": [
    {
      "name": "Expenses",
      "description": "Các API quản lý khoản chi tiêu"
    }
  ],
  "paths": {
    "/expenses": {
      "get": {
        "tags": ["Expenses"],
        "summary": "Lấy danh sách tất cả chi tiêu",
        "operationId": "getExpenses",
        "responses": {
          "200": {
            "description": "Danh sách chi tiêu trả về thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Expense" }
                }
              }
            }
          },
          "500": {
            "description": "Lỗi server"
          }
        }
      },
      "post": {
        "tags": ["Expenses"],
        "summary": "Tạo mới một khoản chi tiêu",
        "operationId": "createExpense",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ExpenseInput" },
              "example": {
                "title": "Ăn trưa",
                "amount": 50000,
                "type": "expense",
                "category": "Food",
                "date": "2026-03-12",
                "note": "Phở bò ngon"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tạo chi tiêu thành công",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Expense" }
              }
            }
          },
          "400": {
            "description": "Thiếu trường bắt buộc"
          },
          "500": {
            "description": "Lỗi server"
          }
        }
      }
    },
    "/expenses/{id}": {
      "get": {
        "tags": ["Expenses"],
        "summary": "Lấy chi tiết một khoản chi tiêu",
        "operationId": "getExpenseById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID của khoản chi tiêu",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Chi tiết chi tiêu",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Expense" }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy khoản chi tiêu"
          },
          "500": {
            "description": "Lỗi server"
          }
        }
      },
      "put": {
        "tags": ["Expenses"],
        "summary": "Cập nhật khoản chi tiêu",
        "operationId": "updateExpense",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID của khoản chi tiêu",
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ExpenseInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cập nhật thành công",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Expense" }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy khoản chi tiêu"
          },
          "500": {
            "description": "Lỗi server"
          }
        }
      },
      "delete": {
        "tags": ["Expenses"],
        "summary": "Xóa một khoản chi tiêu",
        "operationId": "deleteExpense",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID của khoản chi tiêu",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Xóa thành công",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Expense" }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Không tìm thấy khoản chi tiêu"
          },
          "500": {
            "description": "Lỗi server"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Expense": {
        "type": "object",
        "required": ["id", "title", "amount", "type", "category", "date"],
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID duy nhất của chi tiêu",
            "example": 1710201600000
          },
          "title": {
            "type": "string",
            "description": "Tiêu đề chi tiêu",
            "example": "Ăn trưa"
          },
          "amount": {
            "type": "number",
            "description": "Số tiền (VND)",
            "example": 50000
          },
          "type": {
            "type": "string",
            "enum": ["expense", "income"],
            "description": "Loại giao dịch",
            "example": "expense"
          },
          "category": {
            "type": "string",
            "description": "Hạng mục chi tiêu",
            "example": "Food"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Ngày gời chi tiêu (YYYY-MM-DD)",
            "example": "2026-03-12"
          },
          "note": {
            "type": "string",
            "description": "Ghi chú thêm",
            "example": "Phở bò"
          }
        }
      },
      "ExpenseInput": {
        "type": "object",
        "required": ["title", "amount", "type", "category", "date"],
        "properties": {
          "title": {
            "type": "string",
            "description": "Tiêu đề chi tiêu",
            "example": "Ăn trưa"
          },
          "amount": {
            "type": "number",
            "description": "Số tiền (VND)",
            "example": 50000
          },
          "type": {
            "type": "string",
            "enum": ["expense", "income"],
            "description": "Loại giao dịch",
            "example": "expense"
          },
          "category": {
            "type": "string",
            "description": "Hạng mục chi tiêu",
            "example": "Food"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Ngày ghi chi tiêu (YYYY-MM-DD)",
            "example": "2026-03-12"
          },
          "note": {
            "type": "string",
            "description": "Ghi chú thêm (tùy chọn)",
            "example": "Phở bò ngon"
          }
        }
      }
    }
  }
}
